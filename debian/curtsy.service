[Unit]
Description=Curtsy TCP/UDP transparent traffic forwarder
Documentation=man:curtsy(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/curtsy --config /etc/curtsy/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# Least privilege: transient user, only the capabilities the forwarder needs.
# CAP_BPF + CAP_NET_ADMIN load/attach the sockmap and reuseport eBPF programs,
# CAP_NET_BIND_SERVICE covers privileged listen ports. CAP_BPF requires
# kernel >= 5.8; on older kernels remove DynamicUser/AmbientCapabilities and
# run as root instead.
DynamicUser=true
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
