[Unit]
Description=Curtsy TCP/UDP transparent traffic forwarder (instance %i)
Documentation=man:curtsy(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/curtsy --instance %i --config /etc/curtsy/instances/%i.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# Least privilege: transient user, only the capabilities the forwarder needs.
# CAP_BPF + CAP_NET_ADMIN load/attach the sockmap and reuseport eBPF programs,
# CAP_PERFMON feeds the BPF observer kprobes, CAP_NET_BIND_SERVICE covers
# privileged listen ports. CAP_BPF requires kernel >= 5.8; on older kernels
# remove DynamicUser/AmbientCapabilities and run as root instead.
#
# Multi-instance port sharing: SO_REUSEPORT only groups sockets with the same
# effective UID. DynamicUser gives every template instance a distinct uid, so
# two instances cannot share one listen address:port (the second bind fails).
# To share a port across instances, set a fixed User= (or drop DynamicUser and
# run as one user) so the instances share a uid.
DynamicUser=true
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
